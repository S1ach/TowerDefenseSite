{
  "name": "sentinel-tower-defense",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "server": "tsx watch server/index.ts",
    "dev:all": "concurrently -k \"npm:dev\" \"npm:server\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/integration.ts",
    "benchmark": "tsx tests/benchmark.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@react-three/drei": "10.7.0",
    "@react-three/fiber": "9.3.0",
    "@reduxjs/toolkit": "2.12.0",
    "@tailwindcss/vite": "4.3.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "1.45.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-redux": "9.3.0",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "tailwindcss": "4.3.3",
    "three": "0.180.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.3",
    "concurrently": "10.0.5",
    "prisma": "6.12.0",
    "tsx": "4.23.13",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
